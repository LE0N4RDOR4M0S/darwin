# === APP CONFIG ===
APP_NAME=CodigoVivo
APP_ENV=development
APP_PORT=8080

# === GIT & REPOSITORY ===
GIT_REPO_SSH=git@gitlab.com:usuario/codigo-vivo-runtime.git
GIT_USER_NAME="Código Vivo Bot"
GIT_USER_EMAIL=bot@codigovivo.ai
SSH_KEY_PATH=/run/secrets/id_rsa

# === TELEMETRY ===
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
JAEGER_URL=http://jaeger:16686

# === GENERATOR ===
GENERATOR_RULES_PATH=/app/heuristics
GENERATOR_LOG_LEVEL=INFO

# === EVALUATOR ===
EVALUATOR_THRESHOLD_HIGH=0.85
EVALUATOR_THRESHOLD_LOW=0.5

# === ORCHESTRATOR ===
GENERATOR_URL=http://generator:5000/generate
EVALUATOR_URL=http://evaluator:5001/evaluate

# === MINIO ===
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=codigovivo-artifacts

# === GITLAB ===
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_TOKEN_FILE=/run/secrets/gitlab_token

# === SECURITY ===
SECRET_KEY_BASE64=CHAVE_ALEATORIA_GERADA
